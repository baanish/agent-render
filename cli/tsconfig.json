{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
