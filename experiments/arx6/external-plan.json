{
  "version": 1,
  "purpose": "Additional external validation after the ARX6 v2 model was frozen; never development or tuning data.",
  "selection": "Paths and slicing rules are fixed before downloading or measuring any compression output. One sample per listed source; no ranking, deduplication by compression score, or replacement after evaluation.",
  "textLimitUtf16": 8000,
  "jsonLimitUtf16": 16000,
  "textRule": "Use the entire text if within the limit; otherwise the longest prefix ending at a newline at or before the limit. If no newline fits, use a prefix without splitting a surrogate pair. No whitespace normalization.",
  "jsonRule": "Keep the complete original JSON text when it parses and fits the JSON limit; otherwise record an exclusion before encoding. Do not reserialize JSON.",
  "diffRule": "Fetch the actual GitHub commit .diff at the same pinned commit; apply the same complete-line prefix rule. A prefix may end within a hunk and is a text-compression proxy, not a promise of an applicable patch.",
  "thirdPartyText": "Downloaded source and corpus text stay outside the repository. Source licenses apply; only URLs, commit IDs, metadata, reconstruction code, and hashes are committed.",
  "repositories": [
    {
      "repository": "python/cpython",
      "sources": [
        { "path": "README.rst", "kind": "markdown", "language": "en" },
        { "path": "Lib/statistics.py", "kind": "code", "language": "python" },
        { "path": "Lib/json/decoder.py", "kind": "code", "language": "python" },
        { "commitDiff": true, "kind": "diff", "language": "diff" }
      ]
    },
    {
